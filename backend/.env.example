PROJECT_NAME="Team A API"
VERSION="0.1.0"
ENVIRONMENT="development"
API_PREFIX="/api/v1"
DATABASE_URL="postgresql+psycopg://username:password@localhost:5432/smart_campus"
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=30000
BACKEND_CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5555","http://127.0.0.1:5555"]'
GOOGLE_SHEET_ID="YOUR_GOOGLE_SHEET_ID"
GOOGLE_SHEET_GID="1991033635"
WEATHER_ENABLED=true
WEATHER_LATITUDE=34.8102
WEATHER_LONGITUDE=135.5616
WEATHER_TIMEZONE="Asia/Tokyo"
WEATHER_POLL_MINUTES=30
WEATHER_RETENTION_ROWS=300
SYNTHETIC_GENERATION_ENABLED=true
SYNTHETIC_GENERATION_DAYS=7
SYNTHETIC_GENERATION_VERSION="entries-jst-15m-v9"
SYNTHETIC_DEMO_LOOP_ENABLED=false
SYNTHETIC_RETENTION_DAYS=7
PREDICTIONS_ENABLED=true
PREDICTIONS_POLL_MINUTES=30
PREDICTIONS_HORIZON_HOURS=2
PREDICTIONS_RETENTION_ROWS=5000
PREDICTIONS_RETENTION_DAYS=2
PREDICTIONS_MODEL_VERSION="synthetic-fourier-weather-jst-v8"
PREDICTIONS_FOURIER_HARMONICS=6
PREDICTIONS_FOURIER_RIDGE_ALPHA=1.0
PREDICTIONS_FOURIER_MINIMUM_SAMPLES=26
PREDICTIONS_SUNNY_BOOST=0.08
PREDICTIONS_RAINY_PENALTY=0.20
PEOPLE_DISPLAY_ENABLED=true
PEOPLE_DISPLAY_POLL_MINUTES=5
MQTT_PUBLISH_WEATHER=true
MQTT_PUBLISH_PEOPLE_DISPLAY=true
MQTT_PUBLISH_MODEL_STATE=true
MQTT_SUBSCRIBE_MEASUREMENTS=true
MQTT_SUBSCRIBE_THERMAL_IMAGE=true
TEAM_B_MEASUREMENTS_FEED_OPERATIONAL_COUNTS=false
TEAM_B_MEASUREMENT_RETENTION_DAYS=7
TEAM_B_MEASUREMENT_FRESHNESS_MINUTES=15
THERMAL_IMAGE_MAX_BYTES=5242880
THERMAL_IMAGE_FRESHNESS_SECONDS=15
MQTT_HOST="localhost" 
MQTT_PORT=1883
MQTT_CLIENT_ID="team-a-backend"
MQTT_TOPIC_PREFIX="team-b/model"
