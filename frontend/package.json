{
  "name": "smart-campus-team-a-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5555",
    "dev:pi": "VITE_DEV_HOST=0.0.0.0 vite --host 0.0.0.0 --port 5555",
    "build": "tsc -b && vite build",
    "preview:pi": "VITE_PREVIEW_HOST=0.0.0.0 vite preview --host 0.0.0.0 --port 5555",
    "lint": "eslint .",
    "screenshots": "node scripts/screenshots.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "leaflet": "^1.9.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/leaflet": "^1.9.0",
    "@types/node": "^25.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.184.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "playwright": "^1.60.0",
    "prettier": "^3.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0"
  }
}
